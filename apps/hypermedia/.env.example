# Node
TZ=UTC
PORT=3333
HOST=localhost
NODE_ENV=development

# App
LOG_LEVEL=info
APP_KEY=
LIMITER_STORE=memory
APP_URL=http://${HOST}:${PORT}

# Session
SESSION_DRIVER=database

# Masquerade
MASQUERADE_OPERATOR_EMAILS=operator@example.com

# Soft Delete: accounts allowed to list and restore deleted accounts, matched exactly.
# Signup is open, so whoever registers a listed address first holds it.
SOFT_DELETE_ADMIN_EMAILS=admin@example.com
